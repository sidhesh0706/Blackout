  "narrative": {
    "northStar": "Recovery security workspace",
    "overview": "Blackout uses the user's chosen dark cybersecurity direction: navy surfaces, mint signals, precise geometry and purposeful glow. The interface feels like an operating instrument for examining recovery evidence. The former ivory deck direction is superseded.\n\nType and borders carry the hierarchy. Glow marks a restore or a newly observed result; it does not establish a successful outcome. General Blackout product branding stands alone, without competition branding or a demo video.",
    "keyCharacteristics": [
      "Dark navy tonal layers with legible cool text.",
      "Mint actions and preserved-state signals, with explicit outcome labels.",
      "Compact technical evidence alongside clear operational headings.",
      "Bounded event feedback with a reduced-motion path."
    ],
    "rules": [
      {
        "name": "The Evidence Color Rule",
        "body": "Color reinforces an explicit status label; color alone never communicates verification success.",
        "section": "colors"
      },
      {
        "name": "The Readable Label Rule",
        "body": "Never shrink functional labels below 12px to make a layout fit; allow wrapping or scrolling instead.",
        "section": "typography"
      },
      {
        "name": "The Bounded Glow Rule",
        "body": "Animated glow responds to restore or result arrival, runs for a finite duration, and never substitutes for observed evidence.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use dark navy tonal layers and the established mint primary accent.",
      "**Do** pair every outcome color with explicit status text and evidence.",
      "**Do** keep functional labels at least 12px and reserve 11px for minor mono metadata.",
      "**Do** keep restore and result animation finite and honor reduced motion."
    ],
    "donts": [
      "**Don't** reintroduce the superseded ivory direction or competition branding.",
      "**Don't** use glow or healthy business status as proof of containment.",
      "**Don't** add continuous decorative pulsing or a demo video.",
      "**Don't** hide missing evidence behind a successful-looking state."
    ]
  }
}
